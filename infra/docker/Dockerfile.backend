# ---- builder ----
FROM python:3.12-slim AS builder
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --extra dev

# ---- final ----
FROM python:3.12-slim AS final
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/.venv /app/.venv
COPY backend/app ./app
COPY backend/tests ./tests
COPY backend/pyproject.toml backend/uv.lock ./
COPY backend/alembic.ini .
COPY backend/app/db/migrations ./app/db/migrations
COPY backend/scripts ./scripts
ENV PATH="/app/.venv/bin:$PATH"
# No ejecutar como root (M8)
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
# --proxy-headers/--forwarded-allow-ips: confiar X-Forwarded-For solo de nginx local,
# para que rate-limit y lockout de login usen la IP real del cliente y no la del proxy (N1).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "127.0.0.1"]
